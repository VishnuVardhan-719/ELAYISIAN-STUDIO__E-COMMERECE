{
  "name": "elysian-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite frontend --host 0.0.0.0",
    "dev:api": "tsx watch backend/src/index.ts",
    "dev:all": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev\"",
    "build": "tsc -b frontend/tsconfig.json && vite build frontend",
    "preview": "vite preview frontend --host 0.0.0.0",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:api",
    "typecheck:frontend": "tsc -b frontend/tsconfig.json --pretty false",
    "typecheck:api": "tsc -p backend/tsconfig.json --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:frontend": "vitest run --project frontend",
    "test:backend": "vitest run --project backend",
    "test:e2e": "playwright test --config frontend/playwright.config.ts",
    "seed": "tsx database/src/seed.ts",
    "db:inspect": "node database/scripts/inspect-local-db.mjs"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.2.0",
    "@fontsource/newsreader": "^5.2.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.468.0",
    "mongoose": "^9.10.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "sharp": "^0.35.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}
